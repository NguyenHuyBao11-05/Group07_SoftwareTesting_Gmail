<tr><td>type</td><td>xpath=//input[contains(@aria-label,'To') or contains(@aria-label,'Người nhận') or @peoplekit-id]<datalist><option>xpath=//input[contains(@aria-label,'To') or contains(@aria-label,'Người nhận') or @peoplekit-id]</option></datalist></td><td>khoadang2005121@gmail.com</td></tr>
<tr><td>sendKeys</td><td>xpath=//input[contains(@aria-label,'To') or contains(@aria-label,'Người nhận') or @peoplekit-id]<datalist><option>xpath=//input[contains(@aria-label,'To') or contains(@aria-label,'Người nhận') or @peoplekit-id]</option></datalist></td><td>${KEY_ENTER}</td></tr>
<tr><td>runScript</td><td>window.confirm = function() { return false; };<datalist><option></option><option>window.confirm = function() { return false; };</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//div[text()='Send' or text()='Gửi' or contains(@data-tooltip,'Send') or contains(@data-tooltip,'Gửi')]<datalist><option>xpath=//div[@role='button' and (starts-with(@aria-label,'Gửi') or starts-with(@aria-label,'Send'))]</option><option>xpath=//div[text()='Send' or text()='Gửi' or contains(@data-tooltip,'Send') or contains(@data-tooltip,'Gửi')]</option><option>xpath=//div[text()='Send' or text()='Gửi' or contains(@data-tooltip,'Send') or contains(@data-tooltip,'Gửi')]</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>1500<datalist><option>1500</option></datalist></td><td></td></tr>
<tr><td>verifyElementPresent</td><td>xpath=//input[@name='subjectbox']<datalist><option>xpath=//*[contains(text(),'without a subject') or contains(text(),'không có chủ đề')]</option><option>*Gửi thư này mà không có chủ đề*</option><option>*</option><option>xpath=//input[@name='subjectbox']</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>1000<datalist><option>1000</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//*[contains(@aria-label,'Save & close') or contains(@data-tooltip,'Save & close') or contains(@aria-label,'Lưu và đóng') or contains(@data-tooltip,'Lưu và đóng')]<datalist><option>xpath=//*[contains(@aria-label,'Save & close') or contains(@data-tooltip,'Save & close') or contains(@aria-label,'Lưu và đóng') or contains(@data-tooltip,'Lưu và đóng')]</option><option>xpath=//*[contains(@aria-label,'Save & close') or contains(@data-tooltip,'Save & close') or contains(@aria-label,'Lưu và đóng') or contains(@data-tooltip,'Lưu và đóng')]</option></datalist></td><td></td></tr>
