<tr><td>type</td><td>xpath=//input[@name='subjectbox']<datalist><option>xpath=//input[@name='subjectbox']</option></datalist></td><td>Test Gmail Error Mail Format</td></tr>
<tr><td>click</td><td>xpath=//div[@aria-label='Message Body' or @aria-label='Nội dung thư' or @role='textbox']<datalist><option>rget": "xpath=//div[@aria-label='Message Body' or @aria-label='Nội dung thư' or @role='textbox']</option><option>xpath=//div[@aria-label='Message Body' or @aria-label='Nội dung thư' or @role='textbox']</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>1500<datalist><option>1500</option></datalist></td><td></td></tr>
<tr><td>click</td><td>xpath=//div[text()='Send' or text()='Gửi' or contains(@data-tooltip,'Send') or contains(@data-tooltip,'Gửi')]<datalist><option>xpath=//div[text()='Send' or text()='Gửi' or contains(@data-tooltip,'Send') or contains(@data-tooltip,'Gửi')]</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>2000<datalist><option>2000</option></datalist></td><td></td></tr>
<tr><td>verifyElementPresent</td><td>xpath=//div[text()='Lỗi' or contains(text(),'Không nhận dạng được') or contains(text(),'Lỗi')] | //div[@role='alertdialog']<datalist><option>xpath=//div[contains(text(),'Error') or contains(text(),'Please make sure') or contains(text(),'Không hợp lệ') or contains(text(),'Hãy đảm bảo')]</option><option>xpath=//div[text()='Lỗi' or contains(text(),'Không nhận dạng được') or contains(text(),'Lỗi')] | //div[@role='alertdialog']</option></datalist></td><td></td></tr>
</tbody></table>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">TC_4.4_SendEmail_NoSubject_ConfirmationDialog</td></tr>
</thead>
<tbody>
<tr><td>click</td><td>xpath=//div[text()='Compose' or text()='Soạn thư' or contains(@aria-label,'Compose') or contains(@aria-label,'Soạn thư')]<datalist><option>xpath=//div[text()='Compose' or text()='Soạn thư' or contains(@aria-label,'Compose') or contains(@aria-label,'Soạn thư')]</option></datalist></td><td></td></tr>
